generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model Organization { id String @id @default(cuid()); name String; ecos Eco[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Eco { id String @id @default(cuid()); name String @unique; organizationId String; organization Organization @relation(fields:[organizationId],references:[id]); teams Team[]; initiatives Initiative[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([organizationId]) }
model Team { id String @id @default(cuid()); name String @unique; ecoId String; eco Eco @relation(fields:[ecoId],references:[id]); workItems WorkItem[]; sprints Sprint[]; capacitySnapshots CapacitySnapshot[]; initiatives Initiative[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([ecoId]) }
model Supplier { id String @id @default(cuid()); name String @unique; initiatives Initiative[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Okr { id String @id @default(cuid()); code String @unique; title String; progress Float; initiatives Initiative[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Initiative { id String @id; name String; type String; status String; sourceStatus String?; sourceSystem String @default("JIRA"); sourceProject String?; sourceIssueKey String? @unique; sourceUrl String?; progress Int; targetAt DateTime?; ecoId String; eco Eco @relation(fields:[ecoId],references:[id]); teamId String?; team Team? @relation(fields:[teamId],references:[id]); supplierId String?; supplier Supplier? @relation(fields:[supplierId],references:[id]); okrId String?; okr Okr? @relation(fields:[okrId],references:[id]); features Feature[]; dependencies Dependency[]; riskMatrices RiskMatrix[]; actionPlans ActionPlan[]; releases Release[]; transitions StageTransition[]; createdBy String @default("seed"); updatedBy String @default("seed"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([status,ecoId]) @@index([targetAt]) }
model Feature { id String @id @default(cuid()); name String; initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); workItems WorkItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([initiativeId]) }
model WorkItem { id String @id; title String; status String; sourceSystem String @default("JIRA"); sourceProject String?; sourceIssueKey String? @unique; sourceStatus String?; sourceUrl String?; featureId String?; feature Feature? @relation(fields:[featureId],references:[id]); teamId String; team Team @relation(fields:[teamId],references:[id]); sprintId String?; sprint Sprint? @relation(fields:[sprintId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([teamId,status]) }
model Sprint { id String @id @default(cuid()); name String; goal String; teamId String; team Team @relation(fields:[teamId],references:[id]); workItems WorkItem[]; startAt DateTime; endAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([teamId,endAt]) }
model CapacitySnapshot { id String @id @default(cuid()); teamId String; team Team @relation(fields:[teamId],references:[id]); unit String; available Float; committed Float; consumed Float; capturedAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([teamId,capturedAt]) }
model Dependency { id String @id; initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); status String; impact String; requiredAt DateTime; committedAt DateTime?; owner String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([status,requiredAt]) }
model RiskMatrix { id String @id; initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); status String; riskItems RiskItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([initiativeId,status]) }
model RiskItem { id String @id @default(cuid()); matrixId String; matrix RiskMatrix @relation(fields:[matrixId],references:[id]); factor String; severity String; status String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([severity,status]) }
model ActionPlan { id String @id; initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); description String; status String; dueAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([status,dueAt]) }
model Vulnerability { id String @id; title String; severity String; status String; dueAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([severity,status]) }
model Release { id String @id; initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); stage String; targetAt DateTime; readiness Int; controls Json; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([stage,targetAt]) }
model StageTransition { id String @id @default(cuid()); initiativeId String; initiative Initiative @relation(fields:[initiativeId],references:[id]); stage String; enteredAt DateTime; exitedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([initiativeId,enteredAt]) }
model MetricSnapshot { id String @id @default(cuid()); metric String; dimension String; value Float; capturedAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([metric,capturedAt]) }
model Insight { id String @id @default(cuid()); title String; evidence String; impact String; recommendation String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model RecommendedAction { id String @id @default(cuid()); priority String; description String; trigger String; owner String; dueAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@index([priority,dueAt]) }
model Role { id String @id @default(cuid()); name String @unique; users User[]; permissions Permission[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Permission { id String @id @default(cuid()); resource String; action String; roleId String; role Role @relation(fields:[roleId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt @@unique([roleId,resource,action]) }
model User { id String @id @default(cuid()); email String @unique; name String; active Boolean @default(true); roleId String; role Role @relation(fields:[roleId],references:[id]); scope String; lastAccessAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model DataSource { id String @id @default(cuid()); name String @unique; status String; type String; config Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model AuditLog { id String @id @default(cuid()); actorId String?; action String; entity String; entityId String?; metadata Json?; createdAt DateTime @default(now()); @@index([entity,createdAt]) }
